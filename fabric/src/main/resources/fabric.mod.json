{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.radaeli.hotbarlocker.fabric.HotbarLockerFabric"],
    "client": ["com.radaeli.hotbarlocker.fabric.client.HotbarLockerFabricClient"]
  },
  "mixins": ["hotbarlocker.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
